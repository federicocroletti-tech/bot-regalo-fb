# Indirizzi locali. APP_ORIGIN deve coincidere con l'URL mostrato da Vite.
API_PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
SYNC_INTERVAL_MINUTES=360

# Genera un valore casuale locale con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=

# Meta Pages API. Non inserire mai questi valori nel browser o nel repository.
META_APP_ID=
META_APP_SECRET=
# Richiede GitHub Pages attivo sul repository. Vedi README.
META_REDIRECT_URI=https://federicocroletti-tech.github.io/bot-regalo-fb/oauth/meta-callback/
# Facoltativo ma consigliato per Facebook Login for Business.
META_LOGIN_CONFIG_ID=
# ID separati da virgola delle sole Pagine che gestisci e vuoi monitorare.
META_PAGE_IDS=
META_GRAPH_API_VERSION=v26.0

# Google Gmail API. Il connettore legge esclusivamente le email restituite dalla query.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8787/api/auth/gmail/callback
GMAIL_QUERY=from:facebookmail.com newer_than:30d